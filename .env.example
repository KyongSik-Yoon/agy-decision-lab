# Google AI Studio API Key (Gemini Developer API 전용)
# 주의: 사내 코드·민감한 diff 스캔 시 데이터 학습에 사용되지 않는 유료 티어($0.10 / 1M 입력 토큰) 키 분리를 권장합니다.
# agy 본체(~/.gemini/antigravity-cli/settings.json)의 Google 계정(AI Ultra) 세션은 변경하지 마세요.
GEMINI_API_KEY=your_ai_studio_api_key_here

# Decisions API 엔드포인트 및 전용 모델
GEMINI_DECISIONS_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/decisions
GEMINI_DECISION_MODEL=gemini-decision-1

# Gemini 4 모델 패밀리 베이스 설정 (Hydrogen: ~xhigh, Neon: ~xhigh, Carbon: ~high)
AGY_HYDROGEN_BASE=gemini-4-hydrogen
AGY_NEON_BASE=gemini-4-neon
AGY_CARBON_BASE=gemini-4-carbon

# 라우터 확신도(confidence) 임계치 (미달 시 상위 안전 모델·중간 이상 effort로 보수적 승격)
AGY_CONFIDENCE_THRESHOLD=0.60
# 서브에이전트·스웜 라우터 전용 확신도 임계치 및 보호 옵션
AGY_SUBAGENT_CONFIDENCE_THRESHOLD=0.68
AGY_SUBAGENT_PRESERVE_CROSS_FAMILY=1
AGY_SUBAGENT_RESPECT_EXPLICIT=0
# invoke_subagent 티어가 실제로 실행하는 모델. auto(기본): 실행 중인 agy 바이너리를 agy-cli-patch --tiers 로 읽음
# 수동 고정 예: AGY_TIER_MODELS=pro=gemini-4-carbon-high,flash=gemini-4-neon-medium,flash_lite=gemini-4-hydrogen-low
AGY_TIER_MODELS=auto

# MCP 서버 기본 규칙 YAML 경로 (미설정 시 XDG 설정/내장 규칙 자동 탐색)
# AGY_RULES_PATH=~/.config/agy-decision-lab/rules/default_rules.yaml
